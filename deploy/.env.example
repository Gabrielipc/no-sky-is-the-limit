# Copia este archivo como .env en el directorio de despliegue.
# Sustituye IMAGE si pruebas una etiqueta distinta de la publicada por CI.
IMAGE=ghcr.io/gabrielipc/no-sky-is-the-limit:latest

# Puerto de la VM que se publica como puerto 8000 del contenedor.
APP_PORT=8000

# Ruta absoluta y persistente en la VM para releases/atlas30 y searches.sqlite.
ATLAS_RELEASES_PATH=/srv/analogos/releases/atlas30

# Tras validar y montar un piloto versionado, indicar su directorio dentro del contenedor.
# REGOLITH_JEZERO_PILOT_DIR=/workspace/releases/atlas30/pilots/jezero-r3-piloto1

# Motor de similitud: copiar el modelo y el almacén de features a ATLAS_RELEASES_PATH/similarity
# (ver docs/guia-ci-cd-azure-docker.md). Solo hace falta definirlas si se usan otras rutas dentro del contenedor.
# ANALOGOS_SIMILARITY_MODEL=/workspace/releases/atlas30/similarity/motor-similitud-ml-v1.joblib
# ANALOGOS_FEATURE_STORE_DIR=/workspace/releases/atlas30/similarity/feature_store_v1
